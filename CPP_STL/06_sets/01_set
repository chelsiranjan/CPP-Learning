// set stores unique elements 
// sorted automatically in ascending order
// unique, meaning equal or duplicate values are ignored
// can be added or removed, but the value of an existing element cannot be changed
// cannot be accessed by index numbers, because the order is based on sorting and not indexing
// #include <set>
// set<type> setName

#include <iostream>
#include <set>
using namespace std;

int main() {
  // Create a set called cars that will store strings
  set<string> cars = {"Volvo", "BMW", "Ford", "Mazda"};

  // Print set elements
  for (string car : cars) {
    cout << car << "\n";
  }
  return 0;
}

// bmw
// ford
// mazda
// volvo


#include <iostream>
#include <set>
using namespace std;

int main() {
  // Create a set called numbers that will store integers
  set<int> numbers = {1, 7, 3, 2, 5, 9};

  // Print set elements
  for (int num : numbers) {
    cout << num << "\n";
  }
  return 0;
}

// 1
// 2
// 3
// 5
// 7
// 9